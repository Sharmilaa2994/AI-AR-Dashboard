// ============================================================
// AR DASHBOARD
// ============================================================

function ARDashboard({
  cursorPosition,
}) {
  // ==========================================================
  // STATE
  // ==========================================================

  const [
    selectedWidget,
    setSelectedWidget,
  ] = useState(null);

  const [
    hoveredWidget,
    setHoveredWidget,
  ] = useState(null);

  const [
    interactionMessage,
    setInteractionMessage,
  ] = useState(
    "Point at a widget"
  );

  const [
    activeAction,
    setActiveAction,
  ] = useState(null);

  const [
    interactionCount,
    setInteractionCount,
  ] = useState(0);

  const [
    gestureStats,
    setGestureStats,
  ] = useState({
    POINT: 0,
    PINCH: 0,
    TWO_FINGER: 0,
    FIST: 0,
    OPEN_PALM: 0,
  });

  const [
    lastInteraction,
    setLastInteraction,
  ] = useState(
    "Waiting for gesture..."
  );

  const [
    backendStatus,
    setBackendStatus,
  ] = useState("CONNECTING");

  const [
    visionStatus,
    setVisionStatus,
  ] = useState(null);

  const [
    pipelineStatus,
    setPipelineStatus,
  ] = useState(null);

  const [
    backendError,
    setBackendError,
  ] = useState(null);

  const [
    refreshPulse,
    setRefreshPulse,
  ] = useState(false);


  // ==========================================================
  // DASHBOARD DATA
  // ==========================================================

  const {
    data: dashboardData,
    loading: dashboardLoading,
    error: dashboardError,
  } = useDashboardData();


  // ==========================================================
  // REFS
  // ==========================================================

  const widgetRefs =
    useRef({});

  const hoveredWidgetRef =
    useRef(null);

  const selectedWidgetRef =
    useRef(null);

  const previousGestureRef =
    useRef("UNKNOWN");

  const gestureLockRef =
    useRef({
      PINCH: false,
      FIST: false,
      OPEN_PALM: false,
      TWO_FINGER: false,
    });

  const cooldownRef =
    useRef({
      PINCH: false,
      FIST: false,
      OPEN_PALM: false,
      TWO_FINGER: false,
    });

  const timerRef =
    useRef({
      PINCH: null,
      FIST: null,
      OPEN_PALM: null,
      TWO_FINGER: null,
    });

  const refreshTimerRef =
    useRef(null);


  // ==========================================================
  // DERIVED DATA
  // ==========================================================

  const currentGesture = String(
    cursorPosition?.gesture ||
      "UNKNOWN"
  ).toUpperCase();

  const confidence = Math.round(
    Math.max(
      0,
      Math.min(
        1,
        Number(
          cursorPosition?.confidence || 0
        )
      )
    ) * 100
  );

  const cursorActive = Boolean(
    cursorPosition?.visible
  );

  const systemLoad =
    dashboardData?.system_load ?? 0;

  const processingRate =
    dashboardData?.processing_rate ?? 0;

  const activeUsers =
    dashboardData?.active_users ?? "—";


  const totalGestures =
    Object.values(
      gestureStats
    ).reduce(
      (sum, value) =>
        sum + Number(value || 0),
      0
    );


  const healthScore =
    backendStatus === "ONLINE" &&
    visionStatus
      ? 96
      : backendStatus === "CONNECTING"
      ? 82
      : 58;


  // ==========================================================
  // GESTURE DISTRIBUTION
  // ==========================================================

  const gestureDistribution =
    useMemo(
      () => [
        {
          key: "POINT",
          label: "Point",
          icon: "☝",
          value:
            gestureStats.POINT || 0,
          className:
            "text-cyan-300",
          bar:
            "bg-cyan-400",
        },
        {
          key: "PINCH",
          label: "Pinch",
          icon: "🤏",
          value:
            gestureStats.PINCH || 0,
          className:
            "text-purple-300",
          bar:
            "bg-purple-400",
        },
        {
          key: "TWO_FINGER",
          label: "Two",
          icon: "✌",
          value:
            gestureStats.TWO_FINGER || 0,
          className:
            "text-amber-300",
          bar:
            "bg-amber-400",
        },
        {
          key: "FIST",
          label: "Fist",
          icon: "✊",
          value:
            gestureStats.FIST || 0,
          className:
            "text-rose-300",
          bar:
            "bg-rose-400",
        },
        {
          key: "OPEN_PALM",
          label: "Palm",
          icon: "✋",
          value:
            gestureStats.OPEN_PALM || 0,
          className:
            "text-emerald-300",
          bar:
            "bg-emerald-400",
        },
      ],
      [gestureStats]
    );


  // ==========================================================
  // GESTURE TELEMETRY
  // ==========================================================

  const recordGestureEvent =
    useCallback(
      (gesture) => {
        if (!gesture) {
          return;
        }

        const normalizedGesture =
          String(
            gesture
          ).toUpperCase();

        setGestureStats(
          (stats) => ({
            ...stats,
            [normalizedGesture]:
              (
                stats[
                  normalizedGesture
                ] || 0
              ) + 1,
          })
        );

        recordGesture(
          normalizedGesture
        );

        if (import.meta.env.DEV) {
          console.log(
            "AR GESTURE DETECTED:",
            {
              gesture:
                normalizedGesture,
              timestamp:
                new Date().toISOString(),
            }
          );
        }
      },
      []
    );


  // ==========================================================
  // SUCCESSFUL INTERACTION TELEMETRY
  // ==========================================================

  const recordInteraction =
    useCallback(
      (
        gesture,
        message
      ) => {
        if (!gesture) {
          return;
        }

        const normalizedGesture =
          String(
            gesture
          ).toUpperCase();

        setInteractionCount(
          (count) => count + 1
        );

        setLastInteraction(
          `${normalizedGesture}: ${message}`
        );

        if (import.meta.env.DEV) {
          console.log(
            "AR INTERACTION:",
            {
              gesture:
                normalizedGesture,
              message,
              timestamp:
                new Date().toISOString(),
            }
          );
        }
      },
      []
    );


  // ==========================================================
  // BACKEND CONNECTION
  // ==========================================================

  const loadBackendStatus =
    useCallback(
      async () => {
        try {
          const [
            vision,
            pipeline,
          ] = await Promise.all([
            getVisionStatus(),
            getVisionPipeline(),
          ]);

          setVisionStatus(
            vision
          );

          setPipelineStatus(
            pipeline
          );

          setBackendStatus(
            "ONLINE"
          );

          setBackendError(
            null
          );

          return true;
        } catch (error) {
          console.error(
            "BACKEND STATUS ERROR:",
            error
          );

          setBackendStatus(
            "OFFLINE"
          );

          setBackendError(
            error?.message ||
              "Backend unavailable"
          );

          return false;
        }
      },
      []
    );


  useEffect(() => {
    let mounted = true;

    const initialize =
      async () => {
        if (!mounted) {
          return;
        }

        await loadBackendStatus();
      };

    initialize();

    const interval =
      setInterval(
        () => {
          if (mounted) {
            loadBackendStatus();
          }
        },
        5000
      );

    return () => {
      mounted = false;
      clearInterval(
        interval
      );
    };
  }, [
    loadBackendStatus,
  ]);


  // ==========================================================
  // MANUAL REFRESH
  // ==========================================================

  const refreshSystem =
    useCallback(
      async () => {
        setRefreshPulse(
          true
        );

        if (
          refreshTimerRef.current
        ) {
          clearTimeout(
            refreshTimerRef.current
          );
        }

        refreshTimerRef.current =
          setTimeout(
            () => {
              setRefreshPulse(
                false
              );
            },
            700
          );

        await loadBackendStatus();
      },
      [
        loadBackendStatus,
      ]
    );


  // ==========================================================
  // WIDGET DATA
  // ==========================================================

  const widgets = useMemo(
    () => [
      {
        id: "users",
        title: "Active Users",
        value:
          dashboardData?.active_users ??
          "—",
        description:
          "+12.8% from previous period",
        icon: "👥",
      },
      {
        id: "load",
        title: "System Load",
        value:
          dashboardData
            ? `${dashboardData.system_load}%`
            : "—",
        description:
          "Current system utilization",
        icon: "⚡",
      },
      {
        id: "processing",
        title: "Processing Rate",
        value:
          dashboardData
            ? `${dashboardData.processing_rate}%`
            : "—",
        description:
          "Vision pipeline efficiency",
        icon: "◈",
      },
      {
        id: "interactions",
        title: "Interactions",
        value:
          interactionCount.toLocaleString(),
        description:
          "Gesture events processed",
        icon: "✋",
      },
    ],
    [
      dashboardData,
      interactionCount,
    ]
  );


  // ==========================================================
  // SELECT WIDGET
  // ==========================================================

  const selectWidget =
    useCallback(
      (widgetId) => {
        if (!widgetId) {
          return;
        }

        selectedWidgetRef.current =
          widgetId;

        setSelectedWidget(
          widgetId
        );
      },
      []
    );


  // ==========================================================
  // CLEAR SELECTION
  // ==========================================================

  const clearSelection =
    useCallback(
      () => {
        selectedWidgetRef.current =
          null;

        setSelectedWidget(
          null
        );
      },
      []
    );


  // ==========================================================
  // HOVER UPDATE
  // ==========================================================

  const updateHoveredWidget =
    useCallback(
      (widgetId) => {
        if (
          hoveredWidgetRef.current ===
          widgetId
        ) {
          return;
        }

        hoveredWidgetRef.current =
          widgetId;

        setHoveredWidget(
          widgetId
        );
      },
      []
    );


  // ==========================================================
  // FIND CURRENT TARGET
  // ==========================================================

  const findCurrentTarget =
    useCallback(
      () => {
        if (!cursorPosition) {
          return null;
        }

        if (
          typeof cursorPosition.x !==
            "number" ||
          typeof cursorPosition.y !==
            "number"
        ) {
          return null;
        }

        return findTargetWidget(
          cursorPosition.x,
          cursorPosition.y,
          widgetRefs.current
        );
      },
      [cursorPosition]
    );


  // ==========================================================
  // POINT TARGETING
  // ==========================================================

  useEffect(() => {
    if (!cursorPosition) {
      updateHoveredWidget(
        null
      );

      return;
    }

    const visible =
      Boolean(
        cursorPosition.visible
      );

    const gesture =
      String(
        cursorPosition.gesture ||
          "UNKNOWN"
      ).toUpperCase();

    if (
      !visible ||
      gesture !== "POINT"
    ) {
      updateHoveredWidget(
        null
      );

      return;
    }

    const x =
      cursorPosition.x;

    const y =
      cursorPosition.y;

    if (
      typeof x !== "number" ||
      typeof y !== "number"
    ) {
      updateHoveredWidget(
        null
      );

      return;
    }

    const target =
      findTargetWidget(
        x,
        y,
        widgetRefs.current
      );

    updateHoveredWidget(
      target
    );
  }, [
    cursorPosition?.x,
    cursorPosition?.y,
    cursorPosition?.visible,
    cursorPosition?.gesture,
    updateHoveredWidget,
  ]);


  // ==========================================================
  // PROCESS PINCH
  // ==========================================================

  const processPinch =
    useCallback(
      () => {
        const target =
          hoveredWidgetRef.current ||
          findCurrentTarget();

        if (!target) {
          setInteractionMessage(
            "Point at a widget before pinching."
          );

          return;
        }

        selectWidget(
          target
        );

        setInteractionMessage(
          `${target} selected`
        );

        recordInteraction(
          "PINCH",
          `${target} selected`
        );
      },
      [
        findCurrentTarget,
        selectWidget,
        recordInteraction,
      ]
    );


  // ==========================================================
  // PROCESS FIST
  // ==========================================================

  const processFist =
    useCallback(
      () => {
        const selected =
          selectedWidgetRef.current;

        if (selected) {
          setActiveAction(
            null
          );

          clearSelection();

          setInteractionMessage(
            "Widget closed"
          );

          recordInteraction(
            "FIST",
            "Widget closed"
          );
        } else {
          setInteractionMessage(
            "No selected widget to close."
          );
        }
      },
      [
        clearSelection,
        recordInteraction,
      ]
    );


  // ==========================================================
  // PROCESS OPEN PALM
  // ==========================================================

  const processOpenPalm =
    useCallback(
      () => {
        setActiveAction(
          null
        );

        clearSelection();

        updateHoveredWidget(
          null
        );

        setInteractionMessage(
          "Interaction reset"
        );

        recordInteraction(
          "OPEN_PALM",
          "Interaction reset"
        );
      },
      [
        clearSelection,
        updateHoveredWidget,
        recordInteraction,
      ]
    );


  // ==========================================================
  // PROCESS TWO FINGER
  // ==========================================================

  const processTwoFinger =
    useCallback(
      () => {
        const selected =
          selectedWidgetRef.current;

        if (!selected) {
          setInteractionMessage(
            "Select a widget with PINCH first."
          );

          return;
        }

        const action =
          executeWidgetAction(
            selected
          );

        if (!action) {
          setInteractionMessage(
            `${selected} secondary action unavailable`
          );

          return;
        }

        recordWidgetEvent(
          selected,
          "secondary_action"
        );

        setActiveAction(
          action
        );

        const message =
          action.message ||
          `${selected} secondary action`;

        setInteractionMessage(
          message
        );

        recordInteraction(
          "TWO_FINGER",
          message
        );
      },
      [
        recordInteraction,
      ]
    );


  // ==========================================================
  // GESTURE ENGINE
  // ==========================================================

  useEffect(() => {
    if (!cursorPosition) {
      return;
    }

    const gesture =
      String(
        cursorPosition.gesture ||
          "UNKNOWN"
      ).toUpperCase();

    const visible =
      Boolean(
        cursorPosition.visible
      );


    // --------------------------------------------------------
    // Record gesture transitions
    // --------------------------------------------------------

    if (
      visible &&
      gesture !== "UNKNOWN" &&
      previousGestureRef.current !==
        gesture
    ) {
      recordGestureEvent(
        gesture
      );
    }


    // --------------------------------------------------------
    // Reset locks when tracking stops
    // --------------------------------------------------------

    if (
      !visible &&
      gesture === "UNKNOWN"
    ) {
      Object.keys(
        gestureLockRef.current
      ).forEach(
        (key) => {
          gestureLockRef.current[key] =
            false;
        }
      );

      previousGestureRef.current =
        "UNKNOWN";

      return;
    }


    // --------------------------------------------------------
    // Reset locks on gesture transition
    // --------------------------------------------------------

    if (
      previousGestureRef.current !==
      gesture
    ) {
      Object.keys(
        gestureLockRef.current
      ).forEach(
        (key) => {
          if (
            key !== gesture
          ) {
            gestureLockRef.current[key] =
              false;
          }
        }
      );

      previousGestureRef.current =
        gesture;
    }


    // --------------------------------------------------------
    // POINT is targeting only
    // --------------------------------------------------------

    if (
      gesture === "POINT"
    ) {
      return;
    }


    // --------------------------------------------------------
    // Gesture processor
    // --------------------------------------------------------

    const processGesture =
      (
        key,
        handler,
        cooldown
      ) => {
        if (
          gestureLockRef.current[key]
        ) {
          return;
        }

        if (
          cooldownRef.current[key]
        ) {
          return;
        }

        gestureLockRef.current[key] =
          true;

        cooldownRef.current[key] =
          true;

        handler();

        if (
          timerRef.current[key]
        ) {
          clearTimeout(
            timerRef.current[key]
          );
        }

        timerRef.current[key] =
          setTimeout(
            () => {
              cooldownRef.current[key] =
                false;
            },
            cooldown
          );
      };


    if (
      gesture === "PINCH"
    ) {
      processGesture(
        "PINCH",
        processPinch,
        450
      );

      return;
    }


    if (
      gesture === "FIST"
    ) {
      processGesture(
        "FIST",
        processFist,
        700
      );

      return;
    }


    if (
      gesture === "OPEN_PALM"
    ) {
      processGesture(
        "OPEN_PALM",
        processOpenPalm,
        700
      );

      return;
    }


    if (
      gesture === "TWO_FINGER"
    ) {
      processGesture(
        "TWO_FINGER",
        processTwoFinger,
        700
      );
    }
  }, [
