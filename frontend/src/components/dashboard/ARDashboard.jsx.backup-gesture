// ============================================================
// STATUS PILL
// ============================================================

function StatusPill({
  status,
  label,
}) {
  const normalized = String(
    status || ""
  ).toUpperCase();

  const online =
    normalized === "ONLINE" ||
    normalized === "READY" ||
    normalized === "ACTIVE" ||
    normalized === "AVAILABLE" ||
    normalized === "INITIALIZED" ||
    normalized === "TRUE";

  const connecting =
    normalized === "CONNECTING" ||
    normalized === "INITIALIZING" ||
    normalized === "SYNC" ||
    normalized === "WAITING" ||
    normalized === "STANDBY" ||
    normalized === "LOADING";

  return (
    <div
      className={`
        inline-flex
        min-w-0
        items-center
        justify-center
        gap-1.5
        rounded-full
        border
        px-2.5
        py-1.5
        text-[8px]
        font-medium
        uppercase
        tracking-[0.12em]
        whitespace-nowrap
        sm:text-[9px]
        ${
          online
            ? "border-emerald-400/20 bg-emerald-400/5 text-emerald-300"
            : connecting
            ? "border-amber-400/20 bg-amber-400/5 text-amber-300"
            : "border-red-400/20 bg-red-400/5 text-red-300"
        }
      `}
    >
      <span
        className={`
          h-1.5
          w-1.5
          shrink-0
          rounded-full
          ${
            online
              ? "bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.9)]"
              : connecting
              ? "bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.8)]"
              : "bg-red-400 shadow-[0_0_8px_rgba(248,113,113,0.8)]"
          }
        `}
      />

      <span className="truncate">
        {label || status || "UNKNOWN"}
      </span>
    </div>
  );
}


