                  border-white/5
                  bg-black/20
                  p-3
                  sm:p-4
                "
              >

                <div
                  className="
                    mb-4
                    text-[7px]
                    uppercase
                    tracking-[0.2em]
                    text-slate-600
                    sm:text-[8px]
                  "
                >
                  Gesture Distribution
                </div>


                <div
                  className="
                    space-y-3
                    sm:space-y-4
                  "
                >

                  {gestureDistribution.map(
                    (item) => {
                      const percentage =
                        totalGestures > 0
                          ? Math.round(
                              (
                                item.value /
                                totalGestures
                              ) *
                                100
                            )
                          : 0;

                      return (
                        <div
                          key={
                            item.key
                          }
                        >

                          <div
                            className="
                              mb-1.5
                              flex
                              items-center
                              justify-between
                              gap-2
                            "
                          >

                            <div
                              className="
                                flex
                                min-w-0
                                items-center
                                gap-2
                              "
                            >

                              <span
                                className="shrink-0"
                              >
                                {item.icon}
                              </span>

                              <span
                                className={`
                                  truncate
                                  text-[9px]
                                  sm:text-[10px]
                                  ${item.className}
                                `}
                              >
                                {item.label}
                              </span>

                            </div>

                            <span
                              className="
                                shrink-0
                                text-[8px]
                                text-slate-500
                                sm:text-[9px]
                              "
                            >
                              {item.value}
                            </span>

                          </div>


                          <div
                            className="
                              h-1
                              overflow-hidden
                              rounded-full
                              bg-white/5
                            "
                          >

                            <div
                              className={`
                                h-full
                                rounded-full
                                transition-all
                                duration-500
                                ${item.bar}
                              `}
                              style={{
                                width:
                                  `${percentage}%`,
                              }}
                            />

                          </div>

                        </div>
                      );
                    }
                  )}

                </div>

              </div>

            </div>

          </div>


          {/* =================================================
              AI INSIGHT
          ================================================== */}

          <div
            className="
              relative
              min-w-0
              overflow-hidden
              rounded-2xl
              border
              border-cyan-400/10
              bg-gradient-to-br
              from-cyan-400/[0.05]
              via-slate-950/70
              to-purple-500/[0.05]
              p-4
              sm:rounded-3xl
              sm:p-5
            "
          >

            <div
              className="
                pointer-events-none
                absolute
                -right-16
                -top-16
                h-40
                w-40
                rounded-full
                bg-purple-500/10
                blur-3xl
              "
            />


            <SectionHeader
              icon={Sparkles}
              eyebrow="Intelligence Layer"
              title="AI Insight"
              right={
                <span
                  className="
                    rounded-full
                    border
                    border-purple-400/15
                    bg-purple-400/5
                    px-2
                    py-1
                    text-[7px]
                    text-purple-300
                    sm:text-[8px]
                  "
                >
                  LIVE
                </span>
              }
            />


            <div
              className="
                relative
                min-w-0
                rounded-2xl
                border
                border-white/5
                bg-black/20
                p-3
                sm:p-4
              "
            >

              <div
                className="
                  text-[7px]
                  uppercase
                  tracking-[0.2em]
                  text-slate-600
                  sm:text-[8px]
                "
              >
                Detected Intent
              </div>

              <div
                className="
                  mt-1.5
                  truncate
                  text-lg
                  font-semibold
                  text-white
                  sm:mt-2
                  sm:text-xl
                "
              >
                {currentGesture}
              </div>

              <p
                className="
                  mt-2
                  text-[9px]
                  leading-relaxed
                  text-slate-500
                  sm:text-[10px]
                "
              >
                {cursorActive
                  ? "Spatial target tracking is active. The interaction engine is monitoring the current gesture and target."
                  : "Waiting for a valid spatial input from the computer vision pipeline."}
              </p>

            </div>


            <div
              className="
                mt-3
                grid
                grid-cols-2
                gap-2
              "
            >

              {/* CONFIDENCE */}

              <div
                className="
                  min-w-0
                  rounded-xl
                  border
                  border-white/5
                  bg-black/20
                  p-3
                "
              >

                <div
                  className="
                    text-[7px]
                    uppercase
                    tracking-wider
                    text-slate-600
                    sm:text-[8px]
                  "
                >
                  Confidence
                </div>

                <div
                  className="
                    mt-1
                    truncate
                    text-base
                    font-semibold
                    text-cyan-300
                    sm:text-lg
                  "
                >
                  {confidence}%
                </div>

              </div>


              {/* TARGET */}

              <div
                className="
                  min-w-0
                  rounded-xl
                  border
                  border-white/5
                  bg-black/20
                  p-3
                "
              >

                <div
                  className="
                    text-[7px]
                    uppercase
                    tracking-wider
                    text-slate-600
                    sm:text-[8px]
                  "
                >
                  Target
                </div>

                <div
                  className="
                    mt-1
                    truncate
                    text-base
                    font-semibold
                    text-emerald-300
                    sm:text-lg
                  "
                >
                  {selectedWidget
                    ? "LOCKED"
                    : hoveredWidget
                    ? "READY"
                    : "SEARCH"}
                </div>

              </div>

            </div>


            {/* ACTIVE ACTION */}

            <div
              className="
                mt-3
                rounded-xl
                border
                border-cyan-400/10
                bg-cyan-400/[0.03]
                p-3
              "
            >

              <div
                className="
                  flex
                  items-center
                  gap-2
                "
              >

                <Zap
                  size={12}
                  className="shrink-0 text-cyan-400"
                />

                <span
                  className="
                    text-[7px]
                    uppercase
                    tracking-wider
                    text-cyan-300
                    sm:text-[8px]
                  "
                >
                  Active Action
                </span>

              </div>

              <div
                className="
                  mt-2
                  break-words
                  text-[10px]
                  font-medium
                  leading-relaxed
                  text-white
                  sm:text-xs
                "
              >
                {activeAction?.message ||
                  activeAction?.title ||
                  "No active action"}
              </div>

            </div>

          </div>

        </section>


        {/* ===================================================
            PIPELINE OVERVIEW
        ==================================================== */}

        <section
          className="
            mt-4
            overflow-hidden
            rounded-2xl
            border
            border-white/5
            bg-slate-950/60
            p-4
            sm:mt-5
            sm:rounded-3xl
            sm:p-5
          "
        >

          <SectionHeader
            icon={Layers3}
            eyebrow="Computer Vision"
            title="Pipeline Overview"
            right={
              <StatusPill
                status={
                  backendStatus
                }
              />
            }
          />


          <div
            className="
              grid
              gap-3
              sm:grid-cols-2
              lg:grid-cols-4
            "
          >

            <PipelineCard
              label="OpenCV"
              value={
                visionStatus?.opencv ||
                "WAITING"
              }
              icon={CheckCircle2}
              accent="emerald"
            />

            <PipelineCard
              label="Hand Landmarker"
              value={
                pipelineStatus?.mediapipe ||
                "WAITING"
              }
              icon={Hand}
              accent="cyan"
            />

            <PipelineCard
              label="Frame Engine"
              value={
                pipelineStatus?.frame_processing ||
                "WAITING"
              }
              icon={Cpu}
              accent="purple"
            />

            <PipelineCard
              label="Object Detection"
              value={
                pipelineStatus?.object_detection ===
                    "ready" ||
                pipelineStatus?.object_detection ===
                    "initialized"
                  ? "READY"
                  : pipelineStatus?.object_detection ===
                    "not_initialized"
                  ? "STANDBY"
                  : pipelineStatus?.object_detection ||
                    "WAITING"
              }
              icon={Target}
              accent="amber"
            />

          </div>


          {/* DASHBOARD ERROR */}

          {(backendError ||
            dashboardError) && (
            <div
              className="
                mt-4
                flex
                min-w-0
                items-start
                gap-3
                rounded-xl
                border
                border-red-400/10
                bg-red-400/[0.03]
                px-3
                py-3
                text-[10px]
                leading-relaxed
                text-red-300
                sm:px-4
                sm:text-xs
              "
            >

              <AlertTriangle
                size={14}
                className="
                  mt-0.5
                  shrink-0
                "
              />

              <span className="min-w-0 break-words">
                {backendError
                  ? `Backend error: ${backendError}`
                  : `Dashboard error: ${dashboardError}`}
              </span>

            </div>
          )}

        </section>


        {/* ===================================================
            GESTURE COMMAND MAP
        ==================================================== */}

        <section
          className="
            mt-4
            rounded-2xl
            border
            border-white/5
            bg-slate-950/60
            p-4
            sm:mt-5
            sm:rounded-3xl
            sm:p-5
          "
        >

          <SectionHeader
            icon={Radio}
            eyebrow="Spatial Controls"
            title="Gesture Command Map"
            right={
              <span
                className="
                  hidden
                  text-[8px]
                  uppercase
                  tracking-wider
                  text-slate-600
                  sm:block
                "
              >
                Hands-Free Control
              </span>
            }
          />


          <div
            className="
              grid
              gap-2
              grid-cols-1
              sm:grid-cols-2
              lg:grid-cols-5
            "
          >

            {[
              [
                "☝",
                "POINT",
                "Target",
                "cyan",
              ],
              [
                "🤏",
                "PINCH",
                "Select",
                "purple",
              ],
              [
                "✌",
                "TWO FINGER",
                "Action",
                "amber",
              ],
              [
                "✊",
                "FIST",
                "Close",
                "rose",
              ],
              [
                "✋",
                "OPEN PALM",
                "Reset",
                "emerald",
              ],
            ].map(
              ([
                icon,
                gesture,
                action,
                color,
              ]) => (
                <div
                  key={
                    gesture
                  }
                  className="
                    flex
                    min-w-0
                    items-center
                    justify-between
                    gap-3
                    rounded-2xl
                    border
                    border-white/5
                    bg-black/20
                    px-3
                    py-3
                    transition
                    duration-200
                    hover:border-white/10
                    sm:px-4
                  "
                >

                  <div
                    className="
                      flex
                      min-w-0
                      items-center
                      gap-3
                    "
                  >

                    <span
                      className="
                        shrink-0
                        text-lg
                      "
                    >
                      {icon}
                    </span>

                    <div className="min-w-0">

                      <div
                        className={`
                          truncate
                          text-[8px]
                          font-medium
                          uppercase
                          tracking-wider
                          sm:text-[9px]
                          ${
                            color ===
                            "cyan"
                              ? "text-cyan-300"
                              : color ===
                                "purple"
                              ? "text-purple-300"
                              : color ===
                                "amber"
                              ? "text-amber-300"
                              : color ===
                                "rose"
                              ? "text-rose-300"
                              : "text-emerald-300"
                          }
                        `}
                      >
                        {gesture}
                      </div>

                      <div
                        className="
                          mt-0.5
                          truncate
                          text-[8px]
                          text-slate-600
                          sm:text-[9px]
                        "
                      >
                        {action}
                      </div>

                    </div>

                  </div>

                  <ChevronRight
                    size={12}
                    className="
                      shrink-0
                      text-slate-700
                    "
                  />

                </div>
              )
            )}

          </div>

        </section>


        {/* ===================================================
            ACTION PANEL
        ==================================================== */}

        <WidgetActionPanel
          action={
            activeAction
          }

          onClose={
            closeActiveAction
          }
        />


        {/* ===================================================
            ACTION DETAIL
        ==================================================== */}

        {activeAction && (
          <ARWidgetDetail
            action={
              activeAction
            }

            onClose={
              closeActiveAction
            }
          />
        )}

      </div>

    </section>
  );
}


export default ARDashboard;